<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gerenciamento de Carros - StockCar</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <div class="nav-container">
            <a href="/" class="logo">StoreCar</a>
            <div class="nav-links">
                <a href="/projetos" class="nav-link">Carros Disponíveis</a>
                <a href="/gerencia" class="nav-link active">Gerenciar</a>
                <span class="nav-link" style="color: var(--accent);">Olá, <%= user.nome %>!</span>
                <a href="/logout" class="btn-logout">Sair</a>
            </div>
        </div>
    </header>

    <main class="page-container">
        <div class="page-header">
            <div class="page-title">
                <h1>Painel de Gerência</h1>
                <p>Controle completo do estoque de veículos do sistema (CRUD)</p>
            </div>
            <a href="/projetos" class="btn-secondary">👁️ Ver Site Público</a>
        </div>

        <% if (locals.success) { %>
            <div class="alert alert-success">
                <span>✅</span> <%= success %>
            </div>
        <% } %>
        <% if (locals.error) { %>
            <div class="alert alert-danger">
                <span>⚠️</span> <%= error %>
            </div>
        <% } %>

        <div class="management-layout">
            <!-- Coluna de Cadastro -->
            <div class="management-form">
                <h3>Cadastrar Novo Veículo</h3>
                <form action="/gerencia/cadastrar" method="POST">
                    <div class="form-group">
                        <label for="marca">Marca</label>
                        <input type="text" id="marca" name="marca" class="form-control" placeholder="Ex: Ford, Chevrolet" required>
                    </div>

                    <div class="form-group">
                        <label for="modelo">Modelo</label>
                        <input type="text" id="modelo" name="modelo" class="form-control" placeholder="Ex: Mustang, Onix" required>
                    </div>

                    <div class="form-group">
                        <label for="ano">Ano</label>
                        <input type="number" id="ano" name="ano" class="form-control" placeholder="Ex: 2024" min="1900" max="2030" required>
                    </div>

                    <div class="form-group">
                        <label for="qtde_disponivel">Quantidade em Estoque</label>
                        <input type="number" id="qtde_disponivel" name="qtde_disponivel" class="form-control" placeholder="Ex: 5" min="0" required>
                    </div>

                    <button type="submit" class="btn-primary" style="margin-top: 1rem;">
                        ➕ Adicionar ao Estoque
                    </button>
                </form>
            </div>

            <!-- Coluna da Tabela de Listagem -->
            <div class="table-responsive">
                <table class="table-cars">
                    <thead>
                        <tr>
                            <th>Marca</th>
                            <th>Modelo</th>
                            <th>Ano</th>
                            <th>Quantidade</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (cars && cars.length > 0) { %>
                            <% cars.forEach(function(car) { %>
                                <tr>
                                    <td><strong><%= car.marca %></strong></td>
                                    <td><%= car.modelo %></td>
                                    <td><%= car.ano %></td>
                                    <td>
                                        <% if (car.qtde_disponivel <= 0) { %>
                                            <span class="car-badge badge-outstock">⚠️ Esgotado</span>
                                        <% } else { %>
                                            <span class="stock-count"><%= car.qtde_disponivel %></span> unid.
                                        <% } %>
                                    </td>
                                    <td>
                                        <div class="action-buttons">
                                            <!-- Vender -->
                                            <form action="/vender" method="POST" style="display:inline;">
                                                <input type="hidden" name="id" value="<%= car._id %>">
                                                <input type="hidden" name="from" value="/gerencia">
                                                <% if (car.qtde_disponivel <= 0) { %>
                                                    <button type="submit" class="btn-action btn-action-edit" style="background: rgba(255,255,255,0.02); color: var(--text-secondary); border-color: transparent;" disabled title="Esgotado">
                                                        💸 Vendido
                                                    </button>
                                                <% } else { %>
                                                    <button type="submit" class="btn-action" style="background: rgba(16, 185, 129, 0.15); color: #34d399; border-color: rgba(16, 185, 129, 0.2);" title="Vender 1 unidade">
                                                        💸 Vender
                                                    </button>
                                                <% } %>
                                            </form>

                                            <!-- Editar -->
                                            <a href="/gerencia/editar/<%= car._id %>" class="btn-action btn-action-edit" title="Editar informações do carro">
                                                ✏️ Editar
                                            </a>

                                            <!-- Remover -->
                                            <form action="/gerencia/remover" method="POST" style="display:inline;" onsubmit="return confirm('Deseja realmente remover este carro do sistema?');">
                                                <input type="hidden" name="id" value="<%= car._id %>">
                                                <button type="submit" class="btn-action btn-action-delete" title="Excluir carro do sistema">
                                                    🗑️ Excluir
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" style="text-align: center; padding: 3rem; color: var(--text-secondary);">
                                    🚘 Nenhum veículo registrado no momento. Preencha o formulário para adicionar!
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <footer>
        <p>&copy; 2026 StockCar. Desenvolvido para gerenciamento de estoque de veículos.</p>
    </footer>
</body>
</html>
